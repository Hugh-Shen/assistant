{
  "name": "assistant",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "sh -c 'pnpm --dir services redis:dev & redis_pid=$!; pnpm --dir services dev & api_pid=$!; pnpm --dir services worker:dev & worker_pid=$!; trap \"kill $redis_pid $api_pid $worker_pid\" EXIT INT TERM; wait'",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  }
}
